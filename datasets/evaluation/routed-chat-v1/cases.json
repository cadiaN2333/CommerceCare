  "cases": [
    {
      "caseId": "RC-001",
      "question": "SoundBee-A2签收恰好7天，未拆封且配件齐全，按演示规则可以申请无理由退货吗？",
      "topK": 2,
      "expectedStatus": "ANSWERED",
      "expectedStrategy": "MODEL_FILTERED_VECTOR",
      "expectedRecognitionStatus": "RESOLVED",
      "expectedProductModel": "SoundBee-A2",
      "expectedDetectedModels": [
        "SoundBee-A2"
      ],
      "expectedUnknownMentions": [],
      "expectedSourceIds": [
        "expanded-v1-soundbee-a2-return"
      ],
      "expectedAnswerPoints": "说明包含7天边界且按假设条件可申请；不能声称已核验订单或已批准。"
    },
    {
      "caseId": "RC-002",
